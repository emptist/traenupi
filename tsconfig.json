{
  "compilerOptions": {
    "target": "ES2024",
    "module": "Node16",
    "moduleResolution": "Node16",
    "outDir": "dist",
    "rootDir": "src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "baseUrl": ".",
    "paths": {
      "@gleam/*": ["gleam/traenupi_core/build/dev/javascript/*"]
    }
  },
  "include": ["src", "gleam/traenupi_core/build/dev/javascript/**/*.d.mts"],
  "exclude": ["node_modules", "dist"]
}
